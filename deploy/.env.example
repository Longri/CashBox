# Kopieren nach .env (gleicher Ordner wie docker-compose.yml) und ALLE Passwörter ändern.
# Enthält ein Wert ein "$", den Wert in einfache Anführungszeichen setzen: 'pa$$wort'

# Admin-Account der Anwendung (steht nicht in der Datenbank)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern

# Datenbank-Passwörter (werden beim ersten Start der leeren Datenbank festgelegt)
DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-aendern

# Angemeldet bleiben: so viele Tage bleibt man nach dem Login angemeldet (0 = jedes Mal neu anmelden)
REMEMBER_ME_DAYS=14

# Port auf dem Server, unter dem CashBox erreichbar ist.
# Hinter einem Reverse-Proxy auf demselben Server: 127.0.0.1:8080 (nur noch lokal erreichbar)
CASHBOX_PORT=8080

# Image-Version: latest oder eine feste Version wie 1.0.0
CASHBOX_VERSION=latest

# Zeitzone der Anwendung
TZ=Europe/Berlin
